{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF标注工具",
  "version": "7.3.0",
  "identifier": "com.pdflabel.tool",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:8502",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "PDF条文标注工具 v7.3",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../sidecar/*",
      "../frontend/*"
    ]
  }
}
